# HOW TO TURN ON REAL VERIFICATION EMAILS
# 1. Copy this file and name the copy exactly:   secrets.toml    (same folder: .streamlit)
# 2. Keep ONE of the two blocks below, delete the other, and put your real values in.
# 3. Every value must be inside "quotes".
# 4. Test it:  python check_email.py yourname@gmail.com      then restart the app.
# NEVER share or upload secrets.toml - it contains your email password.

# ---------------------------------------------------------------------------
# OPTION A - Gmail  (quick to start, about 500 emails per day)
#   - Turn on 2-Step Verification on the Gmail account.
#   - Create an App password: https://myaccount.google.com/apppasswords
#   - Paste that 16-letter code as SMTP_PASSWORD. Your normal Gmail password will NOT work.
# ---------------------------------------------------------------------------
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_SECURITY = "starttls"
SMTP_USER = "yourapp@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
SMTP_FROM = "JobTok <yourapp@gmail.com>"

# ---------------------------------------------------------------------------
# OPTION B - Brevo (free 300 emails/day, made for apps, works on most hosts)
#   - Sign up at brevo.com, verify your sender email under Senders.
#   - SMTP & API > SMTP tab: copy the Login and create an SMTP key.
#   - If port 587 is blocked on your host, use SMTP_PORT = 2525.
# ---------------------------------------------------------------------------
# SMTP_HOST = "smtp-relay.brevo.com"
# SMTP_PORT = 587
# SMTP_SECURITY = "starttls"
# SMTP_USER = "your-brevo-login@example.com"
# SMTP_PASSWORD = "your-brevo-smtp-key"
# SMTP_FROM = "JobTok <the-sender-email-you-verified@example.com>"
