# HOW TO USE THIS FILE
#   Local computer : copy it to .streamlit/secrets.toml and fill in your values.
#   Streamlit Cloud: open your app > Settings > Secrets and paste your filled-in copy there.
# Every value must be inside "quotes". NEVER upload your filled-in copy to GitHub.
# Test your settings:  python check_storage.py   and   python check_email.py you@gmail.com

# ===========================================================================
# 1) PERMANENT STORAGE  (this is what keeps accounts and videos from disappearing)
#    Create a free project at supabase.com, then:
#    - DATABASE_URL : Project Settings > Database > Connection string > "Session pooler" > URI.
#                     Replace [YOUR-PASSWORD] with your database password.
#    - SUPABASE_URL : Project Settings > API > Project URL
#    - SUPABASE_SERVICE_KEY : Project Settings > API > the SECRET key (service_role). NOT the anon/publishable key.
#    The app creates its tables and a public bucket called "jobtok" by itself.
# ===========================================================================
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY = "paste-the-secret-service-role-key-here"
# SUPABASE_BUCKET = "jobtok"        # optional
# MAX_UPLOAD_MB = "50"              # optional (the free Supabase plan allows 50 MB per file)

# ===========================================================================
# 2) EMAIL for verification codes - keep ONE of the two blocks.
# ===========================================================================
# OPTION A - Gmail: turn on 2-Step Verification, create an App password at
#            https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD (not your normal password).
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_SECURITY = "starttls"
SMTP_USER = "yourapp@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
SMTP_FROM = "JobTok <yourapp@gmail.com>"

# OPTION B - Brevo (free 300 emails/day). If port 587 is blocked on your host use 2525.
# SMTP_HOST = "smtp-relay.brevo.com"
# SMTP_PORT = 587
# SMTP_SECURITY = "starttls"
# SMTP_USER = "your-brevo-login@example.com"
# SMTP_PASSWORD = "your-brevo-smtp-key"
# SMTP_FROM = "JobTok <the-sender-email-you-verified@example.com>"
